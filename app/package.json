    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-react-ui": "^0.9.34",
    "@solana/wallet-adapter-solflare": "^0.6.28",
    "@solana/wallet-adapter-wallets": "^0.19.25",
    "@solana/web3.js": "^1.87.6",
    "assert": "^2.1.0",
    "axios": "^1.6.7",
    "borsh": "^1.0.0",
    "browserify-zlib": "^0.2.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.4.1",
    "constants-browserify": "^1.0.0",
    "crypto-browserify": "^3.12.1",
    "date-fns": "^3.3.1",
    "events": "^3.3.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "html-pdf": "^3.0.1",
    "https-browserify": "^1.0.0",
    "marked": "^12.0.0",
    "os-browserify": "^0.3.0",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-confetti": "^6.1.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.1",
    "react-scripts": "^5.0.1",
    "readable-stream": "^4.4.2",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "url": "^0.11.3",
    "util": "^0.12.5"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "build:program": "cd ../src/program && anchor build",
    "deploy:program:devnet": "cd ../src/program && anchor deploy --provider.cluster devnet",
    "deploy:program:mainnet": "cd ../src/program && anchor deploy --provider.cluster mainnet-beta",
    "generate:idl": "node scripts/generate-idl.js",
    "preflight": "npm run build:program && npm run generate:idl && npm run build",
    "deploy:dev": "node scripts/deploy.js development",
    "deploy:prod": "node scripts/deploy.js production",
    "generate-whitepaper": "node scripts/generate-whitepaper.js",
    "generate-pdf": "node generate-pdf.js"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "babel-loader": "^10.0.0",
    "webpack": "^5.89.0"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!@solana|bn.js|react-native)"
    ]
  }
}
