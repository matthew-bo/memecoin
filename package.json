{
  "name": "memecoin-vote",
  "version": "0.1.0",
  "description": "Memecoin with daily voting functionality for 'best' and 'worst' person polls",
  "main": "index.js",
  "scripts": {
    "start": "cd app && npm start",
    "build": "cd app && npm run build && node scripts/generate-pdf.js",
    "deploy": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:program": "cd src/program && cargo build-bpf",
    "deploy:program": "solana program deploy target/deploy/memecoin_vote.so",
    "generate-pdf": "node scripts/generate-pdf.js",
    "init": "node scripts/init-token.js",
    "create-polls": "node scripts/manage-polls.js create-polls",
    "add-candidate": "node scripts/manage-polls.js add-candidate",
    "close-polls": "node scripts/manage-polls.js close-polls",
    "view-results": "node scripts/manage-polls.js view-results",
    "vote": "node scripts/vote.js",
    "deploy:all": "node scripts/deploy-all.js",
    "airdrop": "node scripts/airdrop.js"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.29.0",
    "@solana/spl-token": "^0.4.0",
    "@solana/web3.js": "^1.87.6",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.4",
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/memecoin-vote.git"
  },
  "keywords": [
    "solana",
    "memecoin",
    "dao",
    "voting",
    "blockchain"
  ],
  "author": "Your Name",
  "license": "MIT"
}
